  "info": {
    "title": "Kernel Crash-Readiness Add-on (kdump, taint, oops/panic)",
    "id": {
      "group": null,
      "name": "TA-kernel",
      "version": "1.0.10"
    },
    "author": [
      {
        "name": "Michael \"JKat54\" Bentley",
        "email": "michael@bentleypc.com",
        "company": "BentleyPC LLC"
      }
    ],
    "releaseDate": "11/16/2026",
    "description": "Collects kernel crash-readiness and crash signals: kexec crash kernel loaded, kdump service state, kernel taint state, uptime, and counts of NEW oops/panic/BUG lines in the kernel journal ring since the previous cycle. Emits JSON events to index=main (sourcetype kernel:status) and kernel.* metrics to index=metrics (sourcetype kernel:metrics); alarm status when new oops/panic/BUG lines are detected.",
